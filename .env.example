# ============================================================
# Soto Servicios Inmobiliarios — Proposal B (Vercel + Notion)
# ============================================================
# NO Pica. NO Supabase CMS. Official Notion API only.
# Set these in Vercel → Project → Settings → Environment Variables.
# Locally, copy to `.env` / `.env.local` (never commit tokens).

# Required for live listings, blog and form writes
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database IDs (defaults match production Soto Notion workspace)
# Override only if you clone the DBs
NOTION_PROPERTIES_DB_ID=2cd4fdc2d1b680e18502f3d427883216
NOTION_BLOG_DB_ID=2cc4fdc2d1b680a796b9f25423376811
NOTION_CONTACTS_DB_ID=2d34fdc2d1b680e287b2fe9728e0446f
NOTION_VALUATION_DB_ID=8c333119a6804e209e36fcae9c97e70f

# Optional analytics (client). Leave empty for zero third-party cookies.
# VITE_GA_MEASUREMENT_ID=

# ============================================================
# Notes
# ============================================================
# - Without NOTION_TOKEN, /api/properties and /api/blog return mock data.
# - Forms (/api/contact, /api/valuation) refuse writes without the token
#   (no fake success).
# - Share each Notion DB with the integration that owns NOTION_TOKEN.
# - Retired: VITE_SUPABASE_*, PICA_*, Bolt/Netlify CMS bridge.
